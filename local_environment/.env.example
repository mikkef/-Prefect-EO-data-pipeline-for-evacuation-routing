# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- RustFS credentials (required; choose your own, don't keep the defaults) ---
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key-use-something-long
S3_BUCKET=portofolio

# --- Where data lives on THIS machine (optional) ---
# Default if unset: ./rustfs-data and ./app-data (next to docker-compose.yml)
# Absolute paths work too, e.g. D:/my-storage/rustfs on Windows or /srv/rustfs on Linux.
# RUSTFS_DATA_DIR=./rustfs-data
# APP_DATA_DIR=./app-data
